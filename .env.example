# Скопируйте в .env.local и заполните значения.
# Ключ хранится только на сервере / в Vercel Environment Variables.
OPENROUTER_API_KEY=sk-or-v1-ваш-новый-ключ
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_APP_NAME="Smart Canteen AI"
# На Vercel подставляется автоматически; укажите свой домен, если он есть.
SITE_URL=http://localhost:3000
